# Vana Soul — Environment Variables

## Vana SDK — Direct Data Portability Controller
# Target environment: "production" (mainnet) or "dev" (moksha testnet)
VANA_ENV=production

# Vana network: "mainnet" (chain 1480) or "moksha" (chain 14800)
# Use "moksha" for testing with mainnet app/API URLs on testnet
VANA_NETWORK=mainnet

# App's EVM private key (0x-prefixed, 32 bytes)
# This is the app's on-chain identity — server-side only, NEVER exposed to browser
# Generate: openssl rand -hex 32 | awk '{print "0x"$1}'
VANA_APP_PRIVATE_KEY=

# App identity (shown in Vana approval modal)
VANA_APP_ID=vana-soul
VANA_APP_NAME=Vana Soul
VANA_APP_URL=https://vana-soul.vercel.app

# Escrow RPC URL — for paid reads (DPv2)
# Without this, readApprovedData throws PaymentRequiredError for paid data
# VANA_DP_RPC_URL=https://rpc.vana.org
# VANA_ESCROW_CONTRACT=0x...

## AI Provider (Identity Analysis)
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
